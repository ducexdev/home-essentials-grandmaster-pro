# Home Essentials - Grandmaster Pro
# Environment Variables (NEVER commit real secrets)

# Supabase - get from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Email - Resend (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here
ORDER_NOTIFICATION_EMAIL=order@homeessentials.com.ng
EMAIL_FROM_ADDRESS=noreply@homeessentials.com.ng
EMAIL_FROM_NAME=Home Essentials Orders

# App
NEXT_PUBLIC_SITE_URL=https://homeessentials.com.ng
NEXT_PUBLIC_WHATSAPP_NUMBER=2347045787045

# Analytics (optional - page works without these)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
